  // kinetic:begin (added by Kinetic's install.sh; uninstall.sh removes it)
  "appearance.kinetic": {"icon":"󰸉","label":"Kinetic","aliases":["kinetic","pill"]},
  "appearance.kinetic.panel": {"icon":"󰒓","label":"Kinetic app","description":"Every module's settings in one window","action":"kinetic app"},
  "appearance.kinetic.wallpaper": {"icon":"󰸉","label":"Wallpaper","description":"Choose, skip, pause, its settings","aliases":["live wallpaper"]},
  "appearance.kinetic.wallpaper.pick": {"icon":"󰋩","label":"Choose wallpaper","description":"Pick from rendered previews","action":"kinetic-wall-pick"},
  "appearance.kinetic.wallpaper.next": {"icon":"󰒭","label":"Next wallpaper","action":"kinetic-wall next"},
  "appearance.kinetic.wallpaper.random": {"icon":"󰒝","label":"Random wallpaper","action":"kinetic-wall random"},
  "appearance.kinetic.wallpaper.pause": {"icon":"󰏤","label":"Pause wallpaper","checked":"kinetic-wall status | grep -q 'paused.:true'","action":"kinetic-wall toggle-pause"},
  "appearance.kinetic.wallpaper.enabled": {"icon":"󰐥","label":"Live wallpaper","description":"Off hands the desktop back to the stock background","checked":"kinetic-wall status | grep -q 'enabled.:true'","action":"kinetic-wall toggle"},
  "appearance.kinetic.wallpaper.settings": {"icon":"󰸉","label":"Wallpaper settings…","description":"What shows, its presets and parameters","action":"kinetic app wallpaper"},
  "appearance.kinetic.wallpaper.library": {"icon":"󰋩","label":"Library…","description":"Every live wallpaper, to pick from","action":"kinetic app library"},
  "appearance.kinetic.wallpaper.engine": {"icon":"󰒓","label":"Engine…","description":"Performance, sound, battery, behavior","action":"kinetic app engine"},
  "appearance.kinetic.bar": {"icon":"󰍜","label":"Bar…","description":"The pill: style, shape, spacing, shadow","action":"kinetic app bar"},
  "appearance.kinetic.glass": {"icon":"󰂵","label":"Glass…","description":"Glass under the bar and behind windows","action":"kinetic app glass"},
  "appearance.kinetic.light": {"icon":"󰛨","label":"Light…","description":"A glow around windows, under the glass","action":"kinetic app light"},
  "appearance.kinetic.motion": {"icon":"󰁔","label":"Motion…","description":"Animations, parallax and pass-through","action":"kinetic app motion"},
  "appearance.kinetic.presets": {"icon":"󰏘","label":"Presets…","description":"Wallpaper, bar and motion, saved together","aliases":["looks"],"action":"kinetic app presets"},
  "appearance.kinetic.modules": {"icon":"󰕰","label":"Modules…","description":"Switch, add and remove modules","action":"kinetic app modules"},
  "appearance.kinetic.settings": {"icon":"󰒓","label":"Settings…","description":"Updates, about and attributions","aliases":["update kinetic"],"action":"kinetic app settings"},
  "appearance.top-bar.background.pill": {"icon":"󰍜","label":"Pill","description":"Kinetic's floating glass capsule","aliases":["pill","pill bar"],"checked":"[[ $(omarchy-bar background) == \"pill\" ]]","action":"kinetic bar on"},
  "appearance.top-bar.background.pill-settings": {"icon":"󰒓","label":"Pill settings…","description":"Style, shape, glass, spacing and shadow","aliases":["pill settings"],"action":"kinetic app bar"},
  // kinetic:end
